urban_mobility:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: '../urban_mobility.duckdb'
      extensions:
        - parquet
    spark_databricks:
      type: spark
      method: http
      schema: urban_mobility_gold
      host: "{{ env_var('DBT_SPARK_HOST', 'adb-xxxx.azuredatabricks.net') }}"
      port: 443
      http_path: "{{ env_var('DBT_SPARK_HTTP_PATH', '/sql/1.0/endpoints/xxxx') }}"
      token: "{{ env_var('DBT_SPARK_TOKEN', 'dapi-xxxx') }}"
